#!/usr/bin/env sh
# slc git hook（post-commit / post-checkout 共用）。
# 只做“轻量校验 + 标记”，绝不自动覆写工作区；hook 的失败不影响已提交内容。
set -eu

repo="$(git rev-parse --show-toplevel)"

# post-checkout 会传入 old/new/flag；flag=0 表示文件 checkout，跳过。
if [ "${3:-}" = "0" ]; then exit 0; fi

if command -v slc >/dev/null 2>&1 && [ -f "$repo/slc.yaml" ]; then
  if ! slc check --quiet; then
    echo "slc: node_graph.json 与 slc.yaml 不一致；显式更新：slc graph --write" >&2
    exit 1
  fi
fi

mkdir -p "$repo/.slc"
touch "$repo/.slc/.git-event"     # server 若在运行会拾取并推 git_state
